# Optional server-side AI service. Keep real values only in .env (ignored by Git).
# Compatible Chat Completions endpoint supporting tool_calls and JSON text replies.
# Base URL ends before /chat/completions, for example https://your-provider.example/v1
MODEL_LAB_AI_BASE_URL=
MODEL_LAB_AI_KEY=
MODEL_LAB_AI_MODEL=
# Start with npm run dev:assistant. Default bind: 127.0.0.1:5328.
