# Optional server-side AI service. Keep real values only in .env (ignored by Git).
# Compatible Chat Completions / Messages endpoint supporting tools and JSON replies.
# Base URL ends before /chat/completions, for example https://your-provider.example/v1
MODEL_LAB_AI_BASE_URL=
MODEL_LAB_AI_KEY=
MODEL_LAB_AI_MODEL=
# Start with npm run dev:assistant. Default bind: 127.0.0.1:5328.
# MiniMax-M3 OpenAI compatibility: https://api.minimax.cn/v1
# Anthropic compatibility is also supported: https://api.minimax.cn/anthropic
# Auto-detected from /anthropic; set explicitly for other compatible gateways.
MODEL_LAB_AI_PROTOCOL=
# auto: M3 question answering disables thinking; Agent uses adaptive thinking.
MODEL_LAB_AI_THINKING=auto
# Includes thinking tokens, not only the final answer; separate from context capacity.
# Local guard accepts 1024–65536, subject to the provider/model limit.
# Without this setting the runtime default remains 8192.
MODEL_LAB_AI_MAX_TOKENS=32768
