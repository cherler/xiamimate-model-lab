    "num_leaves": [7, 15],
    "n_estimators": 200,
    "learning_rate": 0.05,
    "min_child_samples": 30,
    "reg_lambda": 1.0,
    "statistical_timeout_seconds": 90,
    "adaptive_candidates": ["history_router", "history_blend"],
    "selection_note": "Select the lowest-WAPE qualifying learned candidate. If no learned candidate has absolute development bias <= 0.20, release the development-selected strongest baseline and label no qualifying candidate. Exact ties use fewer leaves, then model ID."
